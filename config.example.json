{
  "server": {
    "bind": "127.0.0.1",
    "port": 10080,
    "extra_binds": [],
    "request_timeout_secs": 3600,
    "stream_deadline_secs": 3600,
    "connect_timeout_secs": 10,
    "upstream_read_timeout_secs": 120,
    "sse_keepalive_secs": 15,
    "max_body_bytes": 16777216,
    "max_inflight": 256,
    "admission_wait_secs": 15,
    "drain_secs": 25,
    "upstream_shards": 1,
    "cors_allow_origin": [],
    "client_api_key": null,
    "dialects": [],
    "retry": {
      "max_attempts": 3,
      "base_ms": 250,
      "cap_ms": 5000
    },
    "log_level": "info",
    "log_json": false,
    "log_dir": null,
    "log_prefix": null,
    "log_rotate": "daily",
    "log_keep_files": 8,
    "log_stdout": true,
    "log_tz": "Asia/Jakarta"
  },
  "proxy": {
    "vendors": [
      {
        "name": "plainproxies",
        "url": "http://DC_ACCOUNT-session-{session}-ttl-{ttl_seconds}:PASSWORD@dc.us-pr.plainproxies.com:1338",
        "lanes": 4,
        "session_ttl_secs": 600,
        "session_format": "digits",
        "session_len": 6,
        "prewarm": false,
        "min_lanes": 0
      },
      {
        "name": "proxiware",
        "url": "http://user-ACCOUNT-network-eco-sid-{session}-ttl-{ttl_minutes}:PASSWORD@proxy.proxiware.com:1337",
        "lanes": 4,
        "session_ttl_secs": 3600,
        "session_format": "digits",
        "session_len": 7,
        "min_lanes": 0
      }
    ],
    "rotate_at_pct": 80,
    "prewarm": true,
    "requests_per_lane": 120,
    "idle_retire_secs": 300
  },
  "provider": {
    "name": "openai",
    "base_url": "https://api.openai.com/v1",
    "model_map": {},
    "api_key": null,
    "api_keys": [],
    "max_response_bytes": 67108864
  }
}
