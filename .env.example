# Secrets live HERE, not in config.json — this file is gitignored, the JSON
# config is the shape and gets committed. Real environment variables always
# win over anything set here, so an injected container secret beats a stale
# file. Point somewhere else with OPENCODE2API_ENV_FILE=/etc/opencode2api/prod.env.
# OPENCODE2API_CONFIG=config.json
# OPENCODE2API_ENV_FILE=/etc/opencode2api/prod.env

# --- upstream vendor ---
OPENCODE2API_UPSTREAM_URL=https://api.openai.com/v1
OPENCODE2API_UPSTREAM_KEY=sk-...
# Second and further upstream credentials, comma-separated: the proxy rotates
# across them and spends one (temporarily) when the vendor answers 429, honoring
# its `Retry-After`, or 401/403. Additive with the key above — it becomes slot 0,
# so an existing deployment adds a second account without touching anything.
# Keep the list HERE, not in config.json: a key is a credential, and with two you
# now have a credential file that would otherwise be committed twice as often.
# OPENCODE2API_UPSTREAM_KEYS=sk-second,sk-third

# --- who may call this proxy (unset = open; say so in your deployment) ---
OPENCODE2API_CLIENT_API_KEY=

# --- egress through a proxy vendor -------------------------------------
# The single-vendor quick start. {session} is required — without it every
# lane shares one exit IP and rotation does nothing. Render the TTL in the
# unit YOUR vendor spells: {ttl_seconds} or {ttl_minutes}, from the one
# OPENCODE2API_PROXY_SESSION_TTL_SECS below.
#
#   plainproxies (ttl is SECONDS):
# OPENCODE2API_PROXY_URL=http://ACCOUNT-session-{session}-ttl-{ttl_seconds}:PASSWORD@dc.us-pr.plainproxies.com:1338
#   proxiware (ttl is MINUTES):
# OPENCODE2API_PROXY_URL=http://user-ACCOUNT-network-eco-sid-{session}-ttl-{ttl_minutes}:PASSWORD@proxy.proxiware.com:1337
# OPENCODE2API_PROXY_LANES=4
# OPENCODE2API_PROXY_SESSION_TTL_SECS=3600

# Multiple vendors at once need the config file's `proxy.vendors` array;
# put the credential-bearing URLs there only if that file is NOT committed.

# --- ops ---
# OPENCODE2API_BIND=127.0.0.1
# OPENCODE2API_PORT=8080
# OPENCODE2API_MAX_INFLIGHT=256
# OPENCODE2API_DRAIN_SECS=25
# OPENCODE2API_RETRY_ATTEMPTS=3
# OPENCODE2API_HTTP2_PRIOR_KNOWLEDGE=false
# OPENCODE2API_EXTRA_BINDS=127.0.0.1:8081,[::1]:8081   # full host:port each; never inherits port
# OPENCODE2API_UPSTREAM_SHARDS=1
# OPENCODE2API_LOG_LEVEL=info
# OPENCODE2API_LOG_JSON=false
# RUST_LOG=info
#
# --- rotating log file --------------------------------------------------
# With LOG_DIR set, files are named <service>.<UTC-period>.log and pruned
# in-process to LOG_KEEP_FILES (a mid-period restart can retain one fewer,
# so ask for one more than the days you need; unset = grow without bound).
# Never run logrotate over them — the appender reopens only at rotation.
# Older `svc.log.<date>` files (pre-stamp-last naming) are never pruned —
# delete them once after upgrading.
#
# The prefix defaults to the BIN's name, which is `service` in every fork of
# this template (the program crate is `service`; only the `opencode2api-*` crates get
# renamed). Two deployments sharing a LOG_DIR therefore share a file name, and
# pruning is prefix-scoped — each one culls the other's period files. Set one
# prefix per deployment if you ever co-locate them.
#
# LOG_KEEP_FILES bounds the COUNT of period files, never their size: rotation
# is by UTC period, so a `RUST_LOG=debug` day is one enormous file until the
# next boundary. It is also IGNORED under LOG_ROTATE=never — one unstamped
# file, nothing to prune — so `never` is genuinely unbounded even with a keep
# set (the boot line then says `log_keep_files="ignored (never)"`). And with
# LOG_STDOUT on (the default) the journal mirror is bounded by journald's own
# SystemMaxUse, not by anything here.
# OPENCODE2API_LOG_DIR=/var/log/opencode2api
# OPENCODE2API_LOG_PREFIX=opencode2api        # per-deployment identity; see above
# OPENCODE2API_LOG_ROTATE=daily        # minutely|hourly|daily|weekly|never
# OPENCODE2API_LOG_KEEP_FILES=8
# OPENCODE2API_LOG_STDOUT=true         # keep mirroring to stdout (default on)
