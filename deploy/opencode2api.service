# opencode2api — production unit. Runbook + install steps: docs/production.md (R4).
#
# Design notes, each matching a measured behaviour of the binary:
#   * KillSignal=SIGTERM + TimeoutStopSec > server.drain_secs: the binary
#     drains in-flight SSE on SIGTERM for `drain_secs` (config.production.
#     example.json: 25s) then exits 0. TimeoutStopSec MUST exceed that or
#     systemd escalates to SIGKILL mid-stream. Verified: stop -> clean exit 0.
#   * No TLS here. The proxy speaks plaintext; terminate TLS at a reverse
#     proxy (Caddy/nginx) or a tunnel and point extra_binds at that socket.
#   * Binds stay on privileged-port-free addresses (10080+). Binding :443/:80
#     needs the CAP_NET_BIND_SERVICE block at the bottom uncommented.
#   * client_api_key gates every dialect client route — /health and /metrics
#     are public by design (liveness + scraping). Keep them on loopback/private.

[Unit]
Description=opencode2api — X-to-2api chat proxy
Documentation=file:///usr/share/doc/opencode2api/production.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opencode2api
Group=opencode2api

ExecStart=/usr/local/bin/opencode2api --config /etc/opencode2api/config.json
# The config file includes client_api_key; upstream keys live in the .env the
# loader reads (path explicit — dotenvy's default is CWD-relative).
Environment=OPENCODE2API_ENV_FILE=/etc/opencode2api/.env

# StateDirectory and LogsDirectory are created/chowned to opencode2api. An EXISTING
# ConfigurationDirectory is NOT chowned or chmodded by systemd, hence step 1;
# ConfigurationDirectoryMode applies only when systemd creates it (root-owned).
StateDirectory=opencode2api
StateDirectoryMode=0750
LogsDirectory=opencode2api
LogsDirectoryMode=0750
ConfigurationDirectory=opencode2api
ConfigurationDirectoryMode=0750

Restart=always
RestartSec=2
# MUST exceed server.drain_secs (25s) — the stop contract above.
KillSignal=SIGTERM
TimeoutStopSec=40
TimeoutStartSec=30

# ── hardening ─────────────────────────────────────────────────────────────
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectClock=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

# Resource sizing: 8 permits x a 160 MiB engineering allowance
# [2 x (16 MiB body + 64 MiB response)] = 1280 MiB. The factor of two allows
# raw+parsed overlap but is NOT measured RSS or a strict copy ceiling; folded
# IR can add copies. No RSS benchmark was taken on this tree. MemoryHigh
# throttles allocations (it does not SIGKILL); MemoryMax is the cgroup last
# resort. Recompute config plus both directives together. Formula and 4/8-GiB
# steps: docs/production.md, "Security posture, deliberately simple".
MemoryHigh=1536M
MemoryMax=2G
LimitNOFILE=65536

StandardOutput=journal
StandardError=journal
SyslogIdentifier=opencode2api

# Only when binding a privileged port (80/443); leave commented for 10080+.
# AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
